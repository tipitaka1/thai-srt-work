<ruby>นี่<rt>니</rt></ruby> <00:05:55.860><ruby>ท่าน<rt>탄</rt></ruby> <00:05:56.120><ruby>เรียก<rt>리악</rt></ruby> <00:05:56.420><ruby>ว่า<rt>와</rt></ruby><00:05:56.670> <00:05:59.040><ruby>รู้<rt>루</rt></ruby> <00:06:00.900><ruby>ตาม<rt>땀</rt></ruby> <00:06:01.220><ruby>ความจริง<rt>쾀찡</rt></ruby>
